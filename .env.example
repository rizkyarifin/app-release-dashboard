# Database URL - SQLite for local development
DATABASE_URL=sqlite:///./releases.db

# For production with PostgreSQL:
# DATABASE_URL=postgresql://user:password@host:port/database

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:4321

# Port (optional, defaults to 4321)
PORT=4321

# Google Play Console automation settings
GOOGLE_PLAY_EMAIL=dev@brandsarelive.com
GOOGLE_PLAY_PASSWORD=

# Path to Google Play automation directory (relative to dashboard)
AUTOMATION_PATH=../google-play-automation